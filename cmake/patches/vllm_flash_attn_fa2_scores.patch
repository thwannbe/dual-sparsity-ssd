+// Store the pre-softmax QK scores for the first and last query rows.  The
+// accumulator is still in the MMA-owned register layout here, so partition an
+// identity tensor in exactly the same way to recover each register's logical
+// (query, key) coordinate. This keeps score collection fused with FA2 instead
+// of launching a second QK kernel and rereading the paged KV cache.
+template<typename Kernel_traits, typename Params, typename AccTensor>
+__forceinline__ __device__ void write_first_last_scores(
+        const Params &params, AccTensor &acc_s, const int bidb,
+        const int bidh, const int m_block, const int n_block,
+        const int actual_seqlen_q, const int actual_seqlen_k,
+        const int tidx) {
+    if (params.scores_ptr == nullptr || actual_seqlen_q <= 0) { return; }
+
+    constexpr int kBlockM = Kernel_traits::kBlockM;
+    constexpr int kBlockN = Kernel_traits::kBlockN;
+    const int last_q = actual_seqlen_q - 1;
+    const int first_m_block = 0;
+    const int last_m_block = last_q / kBlockM;
+    if (m_block != first_m_block && m_block != last_m_block) { return; }
+
+    typename Kernel_traits::TiledMma tiled_mma;
+    auto thr_mma = tiled_mma.get_thread_slice(tidx);
+    Tensor cS = make_identity_tensor(Shape<Int<kBlockM>, Int<kBlockN>>{});
+    Tensor tScS = thr_mma.partition_C(cS);
+    Tensor scores = make_tensor(
+        acc_s.data(), FLASH_NAMESPACE::convert_layout_acc_rowcol(acc_s.layout()));
+    Tensor coords = make_tensor(
+        tScS.data(), FLASH_NAMESPACE::convert_layout_acc_rowcol(tScS.layout()));
+
+    auto *scores_ptr = reinterpret_cast<cutlass::bfloat16_t *>(params.scores_ptr);
+    #pragma unroll
+    for (int m = 0; m < size<0>(scores); ++m) {
+        const int query = m_block * kBlockM + get<0>(coords(m, _0{}));
+        if (query != 0 && query != last_q) { continue; }
+        if (query >= actual_seqlen_q) { continue; }
+        const int output_row = query == 0 ? 0 : 1;
+        const int64_t base = bidb * params.scores_batch_stride
+            + bidh * params.scores_head_stride
+            + output_row * params.scores_row_stride;
+        #pragma unroll
+        for (int n = 0; n < size<1>(scores); ++n) {
+            const int key = n_block * kBlockN + get<1>(coords(_0{}, n));
+            if (key < actual_seqlen_k) {
+                scores_ptr[base + key] = cutlass::bfloat16_t(scores(m, n));
+                // For a one-token query the first and last rows are identical.
+                if (last_q == 0) {
+                    scores_ptr[base + params.scores_row_stride + key] =
+                        cutlass::bfloat16_t(scores(m, n));
+                }
+            }
+        }
+    }
+}
+
 
